# ================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ================================
#
# This is for development only. Never use these settings in production!
#
# ================================

# ================================
# APPLICATION ENVIRONMENT
# ================================
NODE_ENV=development
APP_ENV=development
DEBUG=true
LOG_LEVEL=debug

# ================================
# POSTGRESQL CONFIGURATION
# ================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dev_database
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password_only
POSTGRES_SSL_MODE=prefer
POSTGRES_MAX_CONNECTIONS=10

# ================================
# MYSQL CONFIGURATION
# ================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=dev_database
MYSQL_USER=dev_user
MYSQL_ROOT_PASSWORD=dev_root_password_only
MYSQL_PASSWORD=dev_password_only

# ================================
# MONGODB CONFIGURATION
# ================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=dev_database
MONGO_USER=dev_user
MONGO_PASSWORD=dev_password_only
MONGO_AUTH_SOURCE=admin
MONGO_SSL=false

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_password_only
REDIS_TLS=false
REDIS_DB=0

# ================================
# JWT & SESSION SECRETS
# ================================
JWT_SECRET=dev_jwt_secret_not_for_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev_refresh_secret_not_for_production
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=dev_session_secret_not_for_production
COOKIE_SECRET=dev_cookie_secret_not_for_production

# ================================
# ENCRYPTION KEYS
# ================================
ENCRYPTION_KEY=dev_encryption_key_not_for_production
DATA_ENCRYPTION_KEY=dev_data_encryption_key_not_for_production

# ================================
# CORS & SECURITY HEADERS
# ================================
CORS_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXIES=

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ================================
# MONITORING & LOGGING
# ================================
LOG_FORMAT=dev
LOG_TO_FILE=false
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ================================
# EMAIL CONFIGURATION
# ================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dev@localhost

# ================================
# SECURITY SETTINGS (Relaxed for development)
# ================================
BCRYPT_ROUNDS=4
PASSWORD_MIN_LENGTH=6
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_NUMBERS=false
PASSWORD_REQUIRE_SPECIAL=false
MAX_LOGIN_ATTEMPTS=100
LOCKOUT_DURATION=60
SESSION_TIMEOUT=86400
FORCE_HTTPS=false

# ================================
# HEALTH CHECK
# ================================
HEALTHCHECK_INTERVAL=60s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=60s
