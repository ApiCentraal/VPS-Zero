[mysqld]
# MySQL 8.0 Production Configuration
# Enterprise-grade security hardening

#------------------------------------------------------------------------------
# GENERAL
#------------------------------------------------------------------------------
user = mysql
pid-file = /var/run/mysqld/mysqld.pid
socket = /var/run/mysqld/mysqld.sock
datadir = /var/lib/mysql

#------------------------------------------------------------------------------
# NETWORKING
#------------------------------------------------------------------------------
bind-address = 0.0.0.0
port = 3306
max_connections = 200
max_connect_errors = 100
connect_timeout = 10
wait_timeout = 600
interactive_timeout = 600

#------------------------------------------------------------------------------
# SECURITY
#------------------------------------------------------------------------------
# SSL/TLS Configuration - REQUIRED
require_secure_transport = ON
ssl-ca = /var/lib/mysql/ca.pem
ssl-cert = /var/lib/mysql/server-cert.pem
ssl-key = /var/lib/mysql/server-key.pem
tls_version = TLSv1.2,TLSv1.3

# Authentication
default_authentication_plugin = caching_sha2_password
sha256_password_auto_generate_rsa_keys = ON
caching_sha2_password_auto_generate_rsa_keys = ON

# Disable LOCAL INFILE for security
local_infile = 0

# Disable LOAD DATA LOCAL
local-infile = 0

# Symbolic links
symbolic-links = 0

# Show database permissions
skip-show-database

#------------------------------------------------------------------------------
# LOGGING
#------------------------------------------------------------------------------
log_error = /var/log/mysql/error.log
log_error_verbosity = 2

# General query log (disable in production for performance)
general_log = 0
general_log_file = /var/log/mysql/general.log

# Slow query log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 1
log_slow_admin_statements = 1

# Binary logging for replication and point-in-time recovery
log_bin = /var/log/mysql/mysql-bin.log
binlog_format = ROW
binlog_expire_logs_seconds = 604800  # 7 days
max_binlog_size = 100M
sync_binlog = 1

# Server ID for replication
server-id = 1

#------------------------------------------------------------------------------
# PERFORMANCE
#------------------------------------------------------------------------------
# InnoDB Settings
default_storage_engine = InnoDB
innodb_buffer_pool_size = 1G
innodb_log_file_size = 256M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_strict_mode = 1

# Query Cache (deprecated in MySQL 8.0)
# Removed as it's not available

# Thread Cache
thread_cache_size = 50
thread_stack = 256K

# Table Cache
table_open_cache = 4096
table_definition_cache = 2048

# Temporary Tables
tmp_table_size = 64M
max_heap_table_size = 64M

# Sort and Join
sort_buffer_size = 2M
join_buffer_size = 2M
read_buffer_size = 2M
read_rnd_buffer_size = 4M

#------------------------------------------------------------------------------
# REPLICATION
#------------------------------------------------------------------------------
# Master configuration
gtid_mode = ON
enforce_gtid_consistency = ON
log_slave_updates = ON
relay_log = /var/log/mysql/relay-bin
relay_log_recovery = ON

#------------------------------------------------------------------------------
# CHARACTER SET
#------------------------------------------------------------------------------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

#------------------------------------------------------------------------------
# MONITORING
#------------------------------------------------------------------------------
performance_schema = ON
