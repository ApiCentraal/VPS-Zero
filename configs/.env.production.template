# ================================
# PRODUCTION ENVIRONMENT VARIABLES
# ================================
# 
# CRITICAL SECURITY NOTES:
# 1. NEVER commit this file with real values to version control
# 2. Use Docker secrets or HashiCorp Vault for sensitive data in production
# 3. Rotate all secrets regularly (minimum every 90 days)
# 4. Use strong, randomly generated passwords (minimum 32 characters)
# 5. Grant least privilege access to all services
#
# ================================

# ================================
# APPLICATION ENVIRONMENT
# ================================
NODE_ENV=production
APP_ENV=production
DEBUG=false
LOG_LEVEL=info

# ================================
# POSTGRESQL CONFIGURATION
# ================================
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=production
POSTGRES_USER=app_user
# SECURITY: Use /run/secrets/postgres_password in Docker
POSTGRES_PASSWORD=CHANGEME_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_SSL_MODE=require
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=50

# ================================
# MYSQL CONFIGURATION
# ================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=production
MYSQL_USER=app_user
# SECURITY: Use /run/secrets/mysql_password in Docker
MYSQL_ROOT_PASSWORD=CHANGEME_STRONG_PASSWORD_MIN_32_CHARS
MYSQL_PASSWORD=CHANGEME_STRONG_PASSWORD_MIN_32_CHARS
MYSQL_SSL_CA=/etc/ssl/certs/ca.pem
MYSQL_SSL_CERT=/etc/ssl/certs/client-cert.pem
MYSQL_SSL_KEY=/etc/ssl/certs/client-key.pem

# ================================
# MONGODB CONFIGURATION
# ================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=production
MONGO_USER=app_user
# SECURITY: Use /run/secrets/mongo_password in Docker
MONGO_PASSWORD=CHANGEME_STRONG_PASSWORD_MIN_32_CHARS
MONGO_AUTH_SOURCE=admin
MONGO_SSL=true
MONGO_SSL_VALIDATE=true

# Connection string format (with TLS):
# mongodb://app_user:PASSWORD@mongodb:27017/production?authSource=admin&tls=true&tlsCAFile=/path/to/ca.pem

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_HOST=redis
REDIS_PORT=6380
# SECURITY: Use /run/secrets/redis_password in Docker
REDIS_PASSWORD=CHANGEME_STRONG_PASSWORD_MIN_32_CHARS
REDIS_TLS=true
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=10000

# ================================
# JWT & SESSION SECRETS
# ================================
# SECURITY: Generate using: openssl rand -base64 64
JWT_SECRET=CHANGEME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGEME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=CHANGEME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
COOKIE_SECRET=CHANGEME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# ================================
# ENCRYPTION KEYS
# ================================
# SECURITY: Generate using: openssl rand -hex 32
ENCRYPTION_KEY=CHANGEME_GENERATE_WITH_OPENSSL_RAND_HEX_32
DATA_ENCRYPTION_KEY=CHANGEME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ================================
# API KEYS & EXTERNAL SERVICES
# ================================
API_KEY=CHANGEME_API_KEY
API_SECRET=CHANGEME_API_SECRET

# AWS (if used)
AWS_ACCESS_KEY_ID=CHANGEME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGEME_AWS_SECRET_KEY
AWS_REGION=eu-west-1

# ================================
# SSL/TLS CONFIGURATION
# ================================
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key
SSL_CA_PATH=/etc/ssl/certs/ca.crt

# ================================
# CORS & SECURITY HEADERS
# ================================
CORS_ORIGIN=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
TRUSTED_PROXIES=172.17.0.0/16

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# BACKUP CONFIGURATION
# ================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true
# SECURITY: Use /run/secrets/backup_encryption_key in Docker
BACKUP_ENCRYPTION_KEY=CHANGEME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# ================================
# MONITORING & LOGGING
# ================================
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/app/application.log
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ================================
# EMAIL CONFIGURATION
# ================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGEME_SMTP_PASSWORD
SMTP_FROM=noreply@yourdomain.com

# ================================
# SECURITY SETTINGS
# ================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
SESSION_TIMEOUT=1800
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# ================================
# DOCKER SWARM / ORCHESTRATION
# ================================
REPLICAS=3
UPDATE_PARALLELISM=1
UPDATE_DELAY=10s
RESTART_POLICY=on-failure
RESTART_MAX_ATTEMPTS=3

# ================================
# HEALTH CHECK
# ================================
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=40s
